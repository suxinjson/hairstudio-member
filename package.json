{
  "name": "hairstudio-member-app",
  "version": "1.0.0",
  "description": "梦飞空间会员管家 - 独立安卓原生App",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx cap sync android",
    "test": "node --test",
