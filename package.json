{
  "name": "hairstudio-member-app",
  "version": "1.0.0",
  "description": "会员管家 - 独立安卓原生App",
  "type": "module",
  "workspaces": [
    "server",
    "admin"
  ],
  "scripts": {
    "clean": "node tools/clean.mjs",
    "dev": "vite",
    "build": "npm run build:web && npx cap sync android",
    "build:web": "vite build",
    "test": "node tools/test.mjs",
    "refactor:test": "node tools/refactor-tests.mjs",
    "refactor:test:postgres": "node tools/refactor-tests.mjs --postgres",
    "refactor:import": "node tools/relational-import.mjs",
    "refactor:audit": "node tools/refactor-audit.mjs",
    "refactor:capacity:sqlite": "node --expose-gc tools/relational-growth-sqlite.mjs",
    "refactor:capacity:postgres": "node tools/relational-pg-capacity.mjs",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "admin:dev": "npm --workspace=admin run dev",
    "admin:build": "npm --workspace=admin run build",
    "server": "node server/main.js",
    "server:check-voice": "node server/check-voice-network.js",
    "server:migrate": "node server/migrate.js",
    "server:create-owner": "node server/create-owner.js",
    "server:create-platform-admin": "node server/create-platform-admin.js",
    "license:keys": "node tools/license-keys.mjs",
    "server:publish": "node server/publish-release.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "vue": "^3.5.13",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "csv-parse": "^7.0.3",
    "jsdom": "^26.1.0",
    "lucide-vue-next": "^0.469.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@capacitor/cli": {
      "rimraf": {
        "glob": "^14.0.3"
      }
    }
  }
}
