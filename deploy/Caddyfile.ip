{
    default_sni {$PUBLIC_DOMAIN}
}

http://{$PUBLIC_DOMAIN} {
    handle /.well-known/acme-challenge/* {
        root * /var/lib/member-acme
        file_server
    }
    handle {
        redir https://{$PUBLIC_DOMAIN}{uri} 308
    }
}

https://{$PUBLIC_DOMAIN} {
    tls /etc/letsencrypt/live/member-ip/fullchain.pem /etc/letsencrypt/live/member-ip/privkey.pem
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
    handle /api/* {
        reverse_proxy api:48927
    }
    handle /aligenie/* {
        reverse_proxy api:48927
    }
    # 《钢了钢》情侣游戏专属子路径路由
    redir /gang /gang/ 308
    handle_path /gang/* {
        reverse_proxy ganglegang:3000
    }
    redir /admin /admin/ 308
    handle /admin/* {
        root * /srv
        try_files {path} /admin/index.html
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
