# 域名部署：A/AAAA 记录指向服务器，开放 80/443 后 Caddy 自动申请 HTTPS。
# 仅 IP 部署：PUBLIC_DOMAIN 填 124.70.184.136，并按 deploy/ip-https.md 使用专用配置。
PUBLIC_DOMAIN=member.example.com
# App 首次登录的默认地址；已有设备仍使用原来保存的地址。
# 如使用指向 124.70.184.136 的域名和域名证书，请改为该 HTTPS 域名。
VITE_CLOUD_SERVER_URL=https://124.70.184.136
# 在独立 PostgreSQL 上创建全新的数据库。三个连接串必须指向同一个目标数据库。
# 连接串的密码需要 URL 编码。请勿提交真实 .env。
MIGRATION_DATABASE_URL=
DATABASE_URL=
# API 连接串使用 member_app，密码与迁移任务配置的 APP_DATABASE_PASSWORD 一致。
APP_DATABASE_PASSWORD=replace-with-a-different-random-32-character-password
# v2 云端空库恢复专用：迁移时创建 member_recovery，密码须独立且至少 32 位。
# 仍在开发，真实 PG/容量/使用方验收前不能切换营业数据；留空时恢复接口返回 503。
RECOVERY_DATABASE_PASSWORD=
# 与 DATABASE_URL/PG* 指向同一个数据库，用户名必须为 member_recovery；密码须 URL 编码。
RECOVERY_DATABASE_URL=

# 平台登录与商业授权：升级后旧门店需显式授权，不能自动赠送永久授权。
# 初始化平台管理员时临时注入 PLATFORM_ADMIN_USERNAME / PLATFORM_ADMIN_PASSWORD，完成后移除。
# App/网页构建时注入公钥 JSON（仅公钥，可公开）；留空则 App 不接受离线授权码。
VITE_LICENSE_PUBLIC_KEYS=
LICENSE_KEY_ID=main
# 使用 deploy/compose.licensing.yaml 时配置；严禁提交私钥。
LICENSE_PRIVATE_KEY_HOST_FILE=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
# 仅信任 Caddy 固定的私网地址；网段冲突时须同时调整下面两项。
MEMBER_PRIVATE_SUBNET=172.30.184.0/24
MEMBER_PROXY_IP=172.30.184.10
# 与 APK 构建长期使用的证书相同，填写 64 位十六进制 SHA-256。
RELEASE_CERT_SHA256=

# 语音额外允许的完整 HTTPS 来源，逗号分隔；默认 Fish Audio / HeyGen 来源已内置。
VOICE_ALLOWED_ORIGINS=

# 讯飞在线语音合成：可在服务器配置默认凭据，管理网页不返回密钥。
# API_PASSWORD 使用控制台“鉴权信息”的 ak-…，不是另一组 WebSocket APIKey。
XFYUN_APP_ID=
XFYUN_API_PASSWORD=
