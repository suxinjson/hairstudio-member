# 域名部署：A/AAAA 记录指向服务器，开放 80/443 后 Caddy 自动申请 HTTPS。
# 仅 IP 部署：PUBLIC_DOMAIN 填 124.70.184.136，并按 deploy/ip-https.md 使用专用配置。
PUBLIC_DOMAIN=member.example.com
# App 首次登录的默认地址；已有设备仍使用原来保存的地址。
# 如使用指向 124.70.184.136 的域名和域名证书，请改为该 HTTPS 域名。
VITE_CLOUD_SERVER_URL=https://124.70.184.136
# 替换为随机长密码；不要提交真实 .env。
POSTGRES_PASSWORD=replace-with-a-random-32-character-password
# API 只使用独立的非管理员角色；首次部署或升级时新增此项，保留旧管理员密码。
APP_DATABASE_PASSWORD=replace-with-a-different-random-32-character-password
# 仅信任 Caddy 固定的私网地址；网段冲突时须同时调整下面两项。
MEMBER_PRIVATE_SUBNET=172.30.184.0/24
MEMBER_PROXY_IP=172.30.184.10
# 与 APK 构建长期使用的证书相同，填写 64 位十六进制 SHA-256。
RELEASE_CERT_SHA256=

# 语音额外允许的完整 HTTPS 来源，逗号分隔；默认 Fish Audio / HeyGen 来源已内置。
VOICE_ALLOWED_ORIGINS=
